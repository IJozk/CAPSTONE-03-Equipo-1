{
  "name": "data-school-backend",
  "version": "1.0.0",
  "description": "Backend con Node, Express, TypeScript y Supabase",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [
    "express",
    "typescript",
    "supabase",
    "postgres",
    "backend"
  ],
  "author": "Team Data School",
